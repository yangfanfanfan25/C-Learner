# ==============================================================================
# Git 忽略规则
# ==============================================================================

# Python
__pycache__/
.pytest_cache/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
env/
.venv/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# Node
node_modules/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Celery
celerybeat-schedule
celerybeat.pid

# Wiki 系统生成的文件
wiki/raw/
wiki/WIKI_SCHEMA.md

# 前端构建产物
frontend/dist/

# 环境变量（敏感信息）
.env
.env.local
.env.production

# Claude 配置目录
.claude/

# 本地运行数据（SQLite / Milvus / 原始文件，位于仓库根目录 data/）
/data/

# 项目根临时目录（测试临时数据库/文件，禁止写系统 C 盘 Temp）
Temp/
.pytest_tmp/

# Superpowers 头脑风暴可视化 mockup
.superpowers/

# 前端 .gitignore 文件
frontend/.gitignore

# UmiJS 生成文件
frontend/src/.umi-production/
frontend/src/.umi/
